{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4forge",
  "version": "0.1.0",
  "identifier": "dev.4forge.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "4Forge — Local Development Environment",
        "width": 860,
        "height": 560,
        "minWidth": 760,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fredli4qooni/4forge/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRmb3JnZQpSV1FCRlRkR1c2N1hkSEZtT095aGZ1NkV1c0hNTEhQWlR3bk1sSXBubmhFTkJtWWgK"
    }
  }
}
